generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  createdAt DateTime  @default(now())
  avatar    String?
  bio       String?
  city      String?
  state     String?
  animals   Animal[]
  updatedAt DateTime  @updatedAt
}

model Animal {
  id          String   @id @default(uuid())
  name        String
  species     String
  breed       String?
  age         Int?
  size        String?
  sex         String?
  description String?
  status      String   @default("available")
  photo       String?
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
